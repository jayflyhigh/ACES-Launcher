<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="80" android:exitFadeDuration="80">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/search_surface_pressed" />
            <stroke android:width="1dp" android:color="@color/search_outline" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/search_surface_pressed" />
            <stroke android:width="1dp" android:color="@color/search_outline_active" />
            <corners android:radius="@dimen/search_corner_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/search_surface" />
            <stroke android:width="1dp" android:color="@color/search_outline" />
            <corners android:radius="@dimen/search_corner_radius" />
        </shape>
    </item>
</selector>
