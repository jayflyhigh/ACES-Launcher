<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/search_surface" />
            <stroke android:width="1dp" android:color="@color/search_accent" />
            <corners android:radius="@dimen/search_corner_radius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/search_surface" />
            <stroke android:width="1dp" android:color="@color/search_accent" />
            <corners android:radius="@dimen/search_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/search_surface" />
            <stroke android:width="1dp" android:color="@color/search_outline" />
            <corners android:radius="@dimen/search_corner_radius" />
        </shape>
    </item>
</selector>
