<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_quick_panel"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/searchPageSettings"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_quick_bar"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="@string/search_page_settings" />

    <TextView
        android:id="@+id/searchPageAppearance"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_quick_bar"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="@string/search_appearance" />

    <LinearLayout
        android:id="@+id/contactCommands"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_quick_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/decreaseTileCount"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/decrease_tile_count"
            android:padding="12dp"
            android:src="@drawable/ic_remove"
            android:tint="?attr/primaryColor" />

        <TextView
            android:id="@+id/tileCount"
            style="@style/TextSmall"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/one_tile_across" />

        <ImageButton
            android:id="@+id/increaseTileCount"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/increase_tile_count"
            android:padding="12dp"
            android:src="@drawable/ic_add"
            android:tint="?attr/primaryColor" />
    </LinearLayout>
</LinearLayout>
