<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/homeWidgetPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_quick_panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="11dp">

        <LinearLayout
            android:id="@+id/widgetTiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <app.olauncher.ui.quickactions.SquareFrameLayout
                android:id="@+id/widgetHour"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_quick_button"
                android:contentDescription="@string/widget_hour"
                android:focusable="true">

                <TextClock
                    style="@style/QuickTileText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:format12Hour="hh"
                    android:format24Hour="hh"
                    android:importantForAccessibility="no"
                    tools:text="08" />
            </app.olauncher.ui.quickactions.SquareFrameLayout>

            <app.olauncher.ui.quickactions.SquareFrameLayout
                android:id="@+id/widgetMinute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_quick_button"
                android:contentDescription="@string/widget_minute"
                android:focusable="true">

                <TextClock
                    style="@style/QuickTileText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:format12Hour="mm"
                    android:format24Hour="mm"
                    android:importantForAccessibility="no"
                    tools:text="05" />
            </app.olauncher.ui.quickactions.SquareFrameLayout>

            <app.olauncher.ui.quickactions.SquareFrameLayout
                android:id="@+id/widgetAmPm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_quick_button"
                android:contentDescription="@string/widget_am_pm"
                android:focusable="true">

                <TextClock
                    style="@style/QuickTileText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:format12Hour="a"
                    android:format24Hour="a"
                    android:importantForAccessibility="no"
                    tools:text="AM" />
            </app.olauncher.ui.quickactions.SquareFrameLayout>

            <app.olauncher.ui.quickactions.SquareFrameLayout
                android:id="@+id/widgetBattery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_quick_button"
                android:contentDescription="@string/widget_battery"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widgetBatteryIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="3dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_battery_widget"
                        android:tint="?attr/primaryColor" />

                    <TextView
                        android:id="@+id/widgetBatteryPercent"
                        style="@style/QuickTileText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:textSize="15sp"
                        tools:text="85%" />
                </LinearLayout>
            </app.olauncher.ui.quickactions.SquareFrameLayout>
        </LinearLayout>

        <TextClock
            android:id="@+id/widgetDate"
            style="@style/QuickBarText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="5dp"
            android:background="@drawable/bg_quick_bar"
            android:contentDescription="@string/widget_date"
            android:focusable="true"
            android:format12Hour="EEE, MMM dd"
            android:format24Hour="EEE, MMM dd"
            tools:text="Thu, Nov 05" />
    </LinearLayout>
</FrameLayout>
