<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:visibility="gone">

    <app.olauncher.ui.search.AppSearchColorWheel
        android:id="@+id/wheel"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/brightnessValue"
        style="@style/AppSearchColorChannel"
        android:labelFor="@id/brightness"
        android:text="@string/app_search_brightness" />

    <SeekBar
        android:id="@+id/brightness"
        style="@style/AppSearchColorSlider"
        android:max="100"
        android:contentDescription="@string/app_search_brightness" />

    <EditText
        android:id="@+id/hex"
        style="@style/EngineEditField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/app_search_hex"
        android:imeOptions="actionDone"
        android:inputType="textVisiblePassword|textCapCharacters"
        android:maxLength="7"
        android:minHeight="48dp" />
</LinearLayout>
