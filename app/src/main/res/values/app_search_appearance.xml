<!-- English fallback labels remain localizable as translations are added. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="preview_contact_one">Alex Morgan</string>
    <string name="preview_contact_two">Sam Taylor</string>

    <string name="app_search_choose_settings">Layout preview</string>
    <string name="app_search_tile_color">Result tile color</string>
    <string name="app_search_menu_tile_color">Use result tile color for menu tiles</string>
    <string name="app_search_background_color">Page background color</string>
    <string name="app_search_popup_color">Menu background color</string>
    <string name="app_search_independent_menu_color">Menu tile color</string>
    <string name="app_search_spacing">Space between tiles</string>
    <string name="app_search_colors_heading">Colors</string>
    <string name="app_search_colors_hint">Applies only to this search page, in both layouts. Tap a color to open the wheel. Text stays white.</string>
    <string name="app_search_menu_heading">Three-line menu</string>
    <string name="app_search_layout_heading">Layout and padding</string>
    <string name="app_search_layout_hint">Applies only to this page, saved separately for each tile layout. Padding adds space around the results, not inside tiles.</string>
    <string name="app_search_choose_hint">Preview and edit a layout without changing your actual search layout.</string>
    <string name="app_search_color_wheel">Color wheel. Drag to choose hue and saturation. Arrow keys adjust the selection; hex input is also available.</string>
    <string name="app_search_brightness">Brightness</string>
    <string name="app_search_brightness_value">Brightness: %1$d%%</string>
    <string name="app_search_padding_left">Left padding: %1$d dp</string>
    <string name="app_search_padding_right">Right padding: %1$d dp</string>
    <string name="app_search_padding_top">Top padding: %1$d dp</string>
    <string name="app_search_padding_bottom">Bottom padding: %1$d dp</string>
    <string name="app_search_preview">Live Preview</string>
    <string name="app_search_preview_menu">Preview popup menu</string>
    <string name="app_search_transparency_value">Transparency: %1$d%%</string>
    <string name="app_search_spacing_value">%1$d dp</string>
    <string name="app_search_default_spacing">Default: 8 dp vertical, 4 dp horizontal</string>
    <string name="app_search_hex">Hex color (#RRGGBB)</string>
    <string name="app_search_invalid_color">Enter six hexadecimal digits, for example #336699.</string>
    <string name="app_search_top">Top</string>
    <string name="app_search_bottom">Bottom</string>
    <string name="app_search_left">Left</string>
    <string name="app_search_right">Right</string>
    <string name="app_search_sample_settings">Settings</string>

    <style name="AppSearchSettingLabel" parent="TextSmallBold">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="AppSearchColorButton" parent="AppSearchSettingLabel">
        <item name="android:background">@drawable/bg_quick_bar</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="AppSearchColorChannel" parent="TextSmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">8dp</item>
    </style>

    <style name="AppSearchColorSlider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:max">255</item>
        <item name="android:progressTint">?attr/primaryColor</item>
        <item name="android:thumbTint">?attr/primaryColor</item>
    </style>

    <style name="AppSearchSettingsCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_quick_panel</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="AppSearchSettingsHint" parent="TextSmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:alpha">0.75</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
</resources>
